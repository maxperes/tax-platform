# Database
DATABASE_URL="postgresql://tax:tax@localhost:5432/tax_platform?schema=public"
# RDS IAM DB authentication (optional). When true, the password in DATABASE_URL is replaced at runtime
# with a SigV4 auth token; sslmode=require is appended. EC2/task role needs rds-db:connect on the DB user ARN.
# DATABASE_IAM_AUTH=true
# Region of the RDS instance (defaults to AWS_REGION if unset).
# DATABASE_IAM_REGION=us-east-2
# Rotate Prisma + token on this interval in ms (default 600000 = 10 minutes; IAM tokens last ~15 minutes).
# DATABASE_IAM_TOKEN_REFRESH_MS=600000
# Skip prisma migrate on container start (docker-entry.sh; e.g. run migrations from CI).
# API migrates on start by default. Workers skip unless MIGRATE_ON_START=true.
# SKIP_MIGRATE_ON_START=true
# MIGRATE_ON_START=false
# Process role for docker-entry: api (default) or worker
# PROCESS_ROLE=api
# RUN_WORKERS_IN_PROCESS=true

# Redis (required for multi-replica admission, rate limits, BullMQ)
# REDIS_URL="redis://localhost:6379"

# LLM admission / scale
# LLM_MAX_IN_FLIGHT=40
# LLM_TIMEOUT_MS=60000
# LLM_MAX_TOKENS=2048
# LLM_MAX_TOOL_ROUNDS=2
# RATE_LIMIT_CHAT_MAX=60
# RATE_LIMIT_CHAT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# DATABASE_POOL_SIZE=10

# S3-compatible object storage (horizontal-safe uploads). Without this, local UPLOADS_DIR is used.
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false

# Local document vault fallback when S3 is unset (single-instance only)
# UPLOADS_DIR="./uploads"

# API
PORT=4000
JWT_SECRET="change-me-in-production-use-long-random-string"
CORS_ORIGIN="http://localhost:5173"
# Optional: absolute path to apps/web/dist so the API also serves the SPA (single public URL for App Runner, etc.)
# WEB_DIST="/absolute/path/to/apps/web/dist"
# Optional public URL used when users ask where the privacy policy is
PRIVACY_POLICY_URL=""
# Version label stored on consent records (default v1)
# PRIVACY_POLICY_VERSION="v1"
# When true, account deletion is blocked if the user has tax reports (legal retention)
# LEGAL_RETENTION_MODE=false
# If set, GET /api/admin/rule-overrides requires header x-admin-token with this value.
# Required for POST /api/admin/users (admin-only account provisioning).
ADMIN_TOKEN=""
# Public self-service signup. Unset defaults to open registration.
# New accounts are pending until an admin approves them in the web UI.
# REGISTRATION_ENABLED=false

# LLM (defaults to local Ollama OpenAI compatibility when OPENAI_API_KEY is empty)
OPENAI_API_KEY=""
# Omit OPENAI_BASE_URL → http://localhost:11434/v1 when no API key.
# Set OPENAI_BASE_URL= (empty) and leave OPENAI_API_KEY empty to disable LLM (template-only).
# With OPENAI_API_KEY set, omit OPENAI_BASE_URL to use hosted OpenAI.
# OPENAI_BASE_URL="http://localhost:11434/v1"
# Omit OPENAI_MODEL → llama3.2 with local base, gpt-4o-mini with hosted OpenAI only.

